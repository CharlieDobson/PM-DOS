@ECHO OFF
ECHO --- redirection ---
ECHO hello > RT1.TXT
TYPE RT1.TXT
ECHO second line >> RT1.TXT
TYPE RT1.TXT
ECHO --- input redirection ---
ECHO N > RT3.TXT
CHOICE /C:YN The answer comes from a file < RT3.TXT
IF ERRORLEVEL 2 ECHO OK: CHOICE read the N from RT3.TXT
DEL RT3.TXT
ECHO --- DIR into a file ---
DIR RT1.TXT > RT2.TXT
TYPE RT2.TXT
ECHO --- pipe into CHOICE ---
ECHO Y | CHOICE /C:YN Pipe says
IF ERRORLEVEL 2 ECHO FAIL: CHOICE read N
IF NOT ERRORLEVEL 2 IF ERRORLEVEL 1 ECHO OK: the pipe fed CHOICE a Y
DEL RT1.TXT
DEL RT2.TXT
ECHO REDTEST done
