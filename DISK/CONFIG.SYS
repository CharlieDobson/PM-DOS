REM MS-DOS statements
DEVICE=SETVER.EXE
BUFFERS=30,8
FILES=40
FCBS=4,0
LASTDRIVE=Z
STACKS=9,256
DOS=HIGH,UMB
SWITCHES=/K
NUMLOCK=ON

REM PM-DOS statements
EMS=AUTO
LFN=ON
DPMI=ON
NULLTRAP=ON

REM A startup menu: one choice for each block under it.  After five
REM seconds the default is used.  AUTOEXEC.BAT finds the choice in
REM %CONFIG%.
[menu]
MENUITEM=NORMAL,Normal start
MENUITEM=NOUSB,Leave USB to the BIOS
MENUDEFAULT=NORMAL,5
[NORMAL]
USB=ON
[NOUSB]
USB=OFF
