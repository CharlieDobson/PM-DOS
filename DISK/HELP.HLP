                            SUBMENU=ÄÄExamples
 
    [menu]
    MENUITEM=NORMAL,Normal start
    SUBMENU=CARDS,Start with networking

    [CARDS]
    MENUITEM=NE2000,NE2000 card
    MENUITEM=PCNET,PCnet card
 
