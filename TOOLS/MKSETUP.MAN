<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- MKSETUP.MAN - MKSETUP.EXE runs as the user who starts it.  Windows
     Vista and later treat a program with no manifest and "setup" in its
     name as an installer, and refuse to start it without elevation
     ("Access is denied" at the end of BUILD.CMD).  Linked in by
     MKSETUP.RC; NT 3.51 ignores it. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="PMDOS.MKSETUP" version="1.0.0.0"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
