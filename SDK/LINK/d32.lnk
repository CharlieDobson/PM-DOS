# D32.LNK - wlink directives for a PM-DOS program built with Open
# Watcom and -3r (the default)
#
#   wlink @%PMSDK%\LINK\D32.LNK name PROG.EXE file prog.obj
#
# The image is linked for 2000h with class D32HEAD - the header,
# from the library's C0D32 module - first, and D32END last so that the
# BSS goes into the file as zeroes.  D32S.LNK is the same for -3s.
format raw bin
option offset=0x2000
option quiet
option nodefaultlibs
disable 1014
libpath %PMSDK%\LIB\WATCOM
library pmc3r.lib
order clname D32HEAD clname CODE clname DATA clname BSS clname D32END
